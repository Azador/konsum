# Konsum Web-App im lokalen Netz.
#
# Liefert nur statische Dateien aus. HTTPS über eine eigene lokale
# Zertifizierungsstelle (CA) von Caddy: kein Let's Encrypt, kein Zugriff von
# außen nötig. Das Stammzertifikat der CA muss einmalig auf jedem Gerät
# installiert werden, es liegt unter http://<host>:<http-port>/konsum-ca.crt.

{
	local_certs
	skip_install_trust
	auto_https disable_redirects
	admin off
}

https://{$KONSUM_HOST:loboci}:{$KONSUM_HTTPS_PORT:8443}, https://localhost:{$KONSUM_HTTPS_PORT:8443} {
	tls internal

	root * /srv
	encode zstd gzip

	# Einstiegsdateien nie aus dem Browser-Cache, damit Updates ankommen.
	@entry path / /index.html /flutter_bootstrap.js /konsum_sw.js /version.json /manifest.json
	header @entry Cache-Control "no-cache"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	try_files {path} /index.html
	file_server
}

# Unverschlüsselt nur: Stammzertifikat zum Installieren, sonst Umleitung.
http://{$KONSUM_HOST:loboci}:{$KONSUM_HTTP_PORT:8080}, http://localhost:{$KONSUM_HTTP_PORT:8080} {
	handle /konsum-ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		header Content-Disposition "attachment; filename=konsum-ca.crt"
		file_server
	}
	handle {
		redir https://{host}:{$KONSUM_HTTPS_PORT:8443}{uri}
	}
}
