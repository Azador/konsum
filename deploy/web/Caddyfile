# Konsum Web-App im lokalen Netz.
#
# Liefert nur statische Dateien aus. HTTPS über eine eigene lokale
# Zertifizierungsstelle (CA) von Caddy: kein Let's Encrypt, kein Zugriff von
# außen nötig. Das Stammzertifikat der CA muss einmalig auf jedem Gerät
# installiert werden, es liegt unter http://<host>:<http-port>/konsum-ca.crt.
#
# Pfade per Umgebungsvariable: KONSUM_ROOT (Web-App), KONSUM_CA_DIR (CA);
# Standard sind die Pfade im Docker-Container (compose.yaml).

{
	local_certs
	skip_install_trust
	auto_https disable_redirects
	admin off
}

https://{$KONSUM_HOST:loboci}:{$KONSUM_HTTPS_PORT:8443}, https://localhost:{$KONSUM_HTTPS_PORT:8443} {
	tls internal

	root * {$KONSUM_ROOT:/srv}
	encode zstd gzip

	header {
		# Immer beim Server nachfragen (unverändert: kurze 304-Antwort), damit
		# Updates ankommen. Die Dateinamen tragen keine Versionsnummer, ohne
		# diese Angabe nähme der Browser z. B. ein altes main.dart.js.
		Cache-Control no-cache
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		# Cross-Origin-Isolation: Die Verschlüsselung (vodozemac als WASM)
		# braucht gemeinsamen Speicher (SharedArrayBuffer). require-corp statt
		# credentialless, weil Safari nur das kann. Fremde Dateien (Produktbilder,
		# Matrix) erlauben das per CORS/CORP.
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Embedder-Policy require-corp
		-Server
	}

	try_files {path} /index.html
	file_server
}

# Unverschlüsselt nur: Stammzertifikat zum Installieren, sonst Umleitung.
http://{$KONSUM_HOST:loboci}:{$KONSUM_HTTP_PORT:8080}, http://localhost:{$KONSUM_HTTP_PORT:8080} {
	handle /konsum-ca.crt {
		root * {$KONSUM_CA_DIR:/data/caddy/pki/authorities/local}
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		# inline, nicht attachment: Sonst lädt Firefox die Datei nur herunter,
		# statt den Dialog zum Vertrauen der CA zu zeigen.
		header Content-Disposition "inline; filename=konsum-ca.crt"
		file_server
	}
	handle {
		redir https://{host}:{$KONSUM_HTTPS_PORT:8443}{uri}
	}
}
